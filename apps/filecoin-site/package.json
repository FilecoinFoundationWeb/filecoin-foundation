{
  "name": "filecoin-site",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not chrome < 85",
    "not safari < 14",
    "not firefox < 85"
  ],
  "scripts": {
    "prebuild": "qino build",
    "build": "tinacms build && npm run generate-rss && next build --webpack",
    "predev": "qino build",
    "dev": "next dev --webpack",
    "generate-rss": "JITI_TSCONFIG_PATHS=true jiti scripts/generateRSS.ts",
    "lint": "eslint src --fix",
    "start": "next start",
    "test:cypress": "cypress run",
    "test:cypress:open": "cypress open",
    "test:cypress:percy": "percy exec -- cypress run"
  },
  "dependencies": {
    "@filecoin-foundation/ui": "0.0.0",
    "@filecoin-foundation/ui-filecoin": "0.9.1",
    "@filecoin-foundation/utils": "0.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@qino/cms": "^0.16.0",
    "@sentry/nextjs": "^10.46.0",
    "camelcase-keys": "^9.1.3",
    "date-fns": "^4.1.0",
    "feed": "^5.2.0",
    "js-cookie": "^3.0.5",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "next-plausible": "^3.12.5",
    "nuqs": "^2.8.8",
    "ohash": "^2.0.11",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "swr": "^2.4.1",
    "tinacms": "^3.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@filecoin-foundation/eslint-config": "0.0.0",
    "@filecoin-foundation/next-config": "0.0.0",
    "@filecoin-foundation/typescript-config": "0.0.0",
    "@next/eslint-plugin-next": "^16.2.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tinacms/cli": "^2.1.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cypress": "^15.13.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.15.1",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-turbo": "^2.8.20",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
